<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/soloRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="14dp"
    android:background="@drawable/solo_notif_bg">

    <TextView
        android:id="@+id/soloTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quest"
        android:textStyle="bold"
        android:textSize="15sp"
        android:textColor="#EAF2FF"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/soloRemaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/soloTitle"
        android:layout_marginTop="8dp"
        android:text="12:34"
        android:textStyle="bold"
        android:textSize="30sp"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/soloSystemLine"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/soloRemaining"
        android:layout_marginTop="6dp"
        android:text="🟣 SYSTEM: Running"
        android:textSize="12sp"
        android:textColor="#BBD0FF"
        android:maxLines="2"
        android:ellipsize="end" />

    <ProgressBar
        android:id="@+id/soloProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_below="@id/soloSystemLine"
        android:layout_marginTop="10dp"
        android:progress="40"
        android:indeterminate="false" />

    <LinearLayout
        android:id="@+id/soloActionsRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/soloProgress"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/soloBtnPause"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="⏸ Pause"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/solo_btn"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/soloBtnStop"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="🛑 Stop"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/solo_btn"
            android:layout_marginEnd="8dp" />

        <TextView
            android:id="@+id/soloBtnDone"
            android:layout_width="0dp"
            android:layout_height="38dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="✅ Clear"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/solo_btn" />
    </LinearLayout>

</RelativeLayout>
